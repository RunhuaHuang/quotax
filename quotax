#!/usr/bin/env bash

# ==============================================================================
# quotax — QuotaX 一键启动器（由 install.sh 安装到 PATH）
#
# 用法：
#   quotax          启动服务（已在运行则直接打开浏览器）
#   quotax stop     停止后台服务
#   quotax status   查看运行状态
#   quotax log      查看最近日志
#
# 安装位置：~/.local/bin/quotax（install.sh 负责）。
# ==============================================================================

set -e

# 安装目录（install.sh 写入这个占位，找不到则回退默认路径）
PERM_DIR="${QUOTAX_HOME:-$HOME/QuotaX}"
PORT="${QUOTAX_PORT:-8900}"
LOG_FILE="$PERM_DIR/quotax.log"
PID_FILE="$PERM_DIR/quotax.pid"

if ! [[ "$PORT" =~ ^[0-9]{1,5}$ ]] || ((10#$PORT < 1 || 10#$PORT > 65535)); then
  echo "Error: QUOTAX_PORT 必须是 1 到 65535 之间的整数。" >&2
  exit 2
fi

is_quotax_command() {
  local command="$1"
  case "$command" in
    *uvicorn*app.main:app*|*app.main:app*uvicorn*) ;;
    *) return 1 ;;
  esac
  local port_pattern="(^|[[:space:]])--port([[:space:]]+|=)${PORT}($|[[:space:]])"
  [[ "$command" =~ $port_pattern ]]
}

# 返回确认属于当前端口 QuotaX 的进程 PID；不能只凭进程命令判断，否则同一台机器
# 上运行另一个端口的 QuotaX 时，status/stop 可能误认或误杀另一实例。
quotax_pid() {
  local pid command
  if [ -f "$PID_FILE" ]; then
    pid=$(tr -cd '0-9' < "$PID_FILE")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      command=$(ps -p "$pid" -o command= 2>/dev/null || true)
      if is_quotax_command "$command"; then echo "$pid"; return 0; fi
    fi
  fi
  if command -v lsof &>/dev/null; then
    while IFS= read -r pid; do
      command=$(ps -p "$pid" -o command= 2>/dev/null || true)
      if is_quotax_command "$command"; then echo "$pid"; return 0; fi
    done < <(lsof -ti tcp:"$PORT" -sTCP:LISTEN 2>/dev/null || true)
  fi
  return 1
}

is_running() {
  quotax_pid >/dev/null
}

open_browser() {
  URL="http://127.0.0.1:$PORT"
  (command -v open &>/dev/null && open "$URL") \
    || (command -v xdg-open &>/dev/null && xdg-open "$URL") \
    || true
}

case "${1:-start}" in
  start|"")
    if is_running; then
      echo "QuotaX 已在运行 → 打开浏览器"
      open_browser
      exit 0
    fi
    if [ ! -d "$PERM_DIR" ] || [ ! -f "$PERM_DIR/app/main.py" ]; then
      echo "Error: 未找到 QuotaX 安装目录 $PERM_DIR" >&2
      echo "       请先运行安装脚本，或设置 QUOTAX_HOME 指向安装目录。" >&2
      exit 1
    fi
    cd "$PERM_DIR"
    # 确保 uv 在 PATH（install.sh 装到 ~/.local/bin）
    export PATH="$HOME/.local/bin:$PATH"
    if ! command -v uv &>/dev/null; then
      echo "Error: 未找到 uv。请先安装 uv（macOS: brew install uv）。" >&2
      exit 1
    fi
    # 日志超过 5 MiB 时在启动前轮转一份，避免 quotax.log 无限增长。
    if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -gt 5242880 ]; then
      mv -f "$LOG_FILE" "$LOG_FILE.1"
    fi
    # 后台启动 uvicorn，nohup 保证退出终端后服务继续运行。
    mkdir -p "$PERM_DIR"
    nohup uv run uvicorn app.main:app --host 127.0.0.1 --port "$PORT" > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo -n "启动 QuotaX（端口 $PORT）"
    # 轮询等待就绪（最多 30 秒）
    for _ in $(seq 1 30); do
      if is_running; then
        echo " ✅"
        open_browser
        echo "地址: http://127.0.0.1:$PORT"
        echo "日志: $LOG_FILE"
        exit 0
      fi
      echo -n "."
      sleep 1
    done
    echo ""
    echo "⚠️  服务仍在启动中，请稍后访问 http://127.0.0.1:$PORT"
    echo "   日志: $LOG_FILE"
    ;;

  stop)
    if PID=$(quotax_pid); then
      kill "$PID" 2>/dev/null || true
      # uv run may leave a child uvicorn process behind. Re-scan the same
      # command/port identity briefly, then use KILL only for the still
      # matching QuotaX process rather than any unrelated listener.
      for _ in $(seq 1 5); do
        sleep 0.2
        if NEXT_PID=$(quotax_pid); then
          kill "$NEXT_PID" 2>/dev/null || true
        else
          break
        fi
      done
      if NEXT_PID=$(quotax_pid); then
        kill -KILL "$NEXT_PID" 2>/dev/null || true
      fi
      echo "QuotaX 已停止"
    else
      echo "QuotaX 未在运行"
    fi
    rm -f "$PID_FILE"
    ;;

  status)
    if is_running; then
      echo "✅ QuotaX 运行中 → http://127.0.0.1:$PORT"
    else
      echo "❌ QuotaX 未运行（用 quotax 启动）"
    fi
    ;;

  log)
    LOG_LINES="${2:-50}"
    if ! [[ "$LOG_LINES" =~ ^[0-9]{1,5}$ ]] || ((10#$LOG_LINES < 1 || 10#$LOG_LINES > 10000)); then
      echo "Error: 日志行数必须是 1 到 10000 之间的整数。" >&2
      exit 2
    fi
    if [ -f "$LOG_FILE" ]; then
      tail -n "$((10#$LOG_LINES))" "$LOG_FILE"
    else
      echo "无日志文件: $LOG_FILE"
    fi
    ;;

  *)
    echo "用法: quotax [start|stop|status|log]" >&2
    echo "  start (默认)  启动服务并打开浏览器" >&2
    echo "  stop          停止后台服务" >&2
    echo "  status        查看运行状态" >&2
    echo "  log [N]       查看最近 N 行日志（默认 50）" >&2
    exit 2
    ;;
esac
